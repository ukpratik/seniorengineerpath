<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Cloud backup and device transfer carry settings and progress (DataStore files) and nothing else. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
