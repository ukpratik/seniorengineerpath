{
  "name": "seniorengineerpath",
  "version": "0.1.0",
  "private": true,
  "description": "SeniorPath: from mid-level to senior software engineer. How real systems are built, broken and fixed, in simple English.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "gate": "node --experimental-strip-types scripts/run-gate.ts",
    "export:app": "node --experimental-strip-types scripts/export-app-content.ts",
    "build": "astro build --force && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/rss": "4.0.19",
    "astro": "7.3.7",
    "hast-util-to-html": "9.0.5",
    "hastscript": "9.0.1",
    "mdast-util-to-string": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "unist-util-visit-parents": "6.0.2",
    "vfile": "6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "pagefind": "1.5.2",
    "rehype-raw": "7.0.0",
    "rehype-stringify": "10.0.1",
    "remark-rehype": "11.1.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
