---
// Case-study library (US-020): how real companies built things, linking to their own write-ups.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { siteData } from '../lib/site-data.ts';

const d = await siteData();
const cases = (await getCollection('cases', (c) => c.data.verified)).map((c) => c.data).sort((a, b) => a.company.localeCompare(b.company) || a.title.localeCompare(b.title));
const tags = [...new Set(cases.flatMap((c) => c.tags))].sort();
const lessonsFor = (ids: string[]) => ids.map((id) => d.byId.get(id)).filter((t) => t && t.written);
---
<Base title="Case studies" description={`${cases.length} short case studies for software engineers: how real companies built and scaled their systems, in simple English, with links to each company's own write-up.`} current="search">
  <TopBar />
  <main id="main" class="page" data-pagefind-body data-pagefind-filter="type:Case study">
    <p class="eyebrow" data-pagefind-ignore>Case studies</p>
    <h1 class="ptitle">How real companies built it</h1>
    <p class="plede">Short notes on engineering write-ups from real companies: what they built, and the lesson for you. Each card links to the original post.</p>
    <div class="tagbar" role="group" aria-label="Filter by tag" data-pagefind-ignore>
      <button type="button" class="chip" aria-pressed="true" data-tag="">All</button>
      {tags.map((t) => <button type="button" class="chip" aria-pressed="false" data-tag={t}>{t}</button>)}
    </div>
    <p class="small count" aria-live="polite" data-count-inc>{cases.length} case studies</p>
    <ul class="grid3">
      {cases.map((c) => {
        const ls = lessonsFor(c.lessons);
        return (
          <li class="card inc" data-tags={c.tags.join(' ')}>
            <span class="when" data-pagefind-ignore><Icon name="briefcase" />{c.company}</span>
            <h2 style="font-size:18px" id={c.id}>{c.title}</h2>
            <p>{c.lesson}</p>
            <div class="chips" data-pagefind-ignore>{c.tags.map((t) => <span class="chip">{t}</span>)}</div>
            <div class="links" data-pagefind-ignore>
              <a href={c.url} target="_blank" rel="noopener"><Icon name="ext" small />Read the original<span class="sr"> (opens in a new tab)</span></a>
              {ls.map((l) => <a href={`/learn/${l!.slug}`}><Icon name="book" small />{l!.title}</a>)}
            </div>
          </li>
        );
      })}
    </ul>
    <Footer />
  </main>
  <script>
    import { initUi } from '../scripts/ui.ts';
    import { initTagFilter } from '../scripts/tag-filter.ts';
    initUi();
    initTagFilter('case studies');
  </script>
</Base>
